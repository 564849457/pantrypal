-
-    const card =
-      event.currentTarget.closest(
-        "[data-recipe-card]",
-      ) as HTMLElement | null;
-
-    if (!card) {
-      router.push(
-        href,
-      );
-
-      return;
-    }
-
-    lockedRef.current =
-      true;
-
-    startBurnAnimation(
-      card,
-      event.clientX,
-      event.clientY,
-      duration,
