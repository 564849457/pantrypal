-  const router =
-    useRouter();
-
-  const lockedRef =
-    useRef(false);
-
-  function handleClick(
-    event: MouseEvent<HTMLAnchorElement>,
-  ) {
-    /*
-     * Preserve native browser behaviour:
-     *
-     * Ctrl click
-     * Cmd click
-     * Shift click
-     * Alt click
-     * middle-click
